*DS_Store*

# Raw and derived images / datasets (large, regenerable) - keep locally only.
# The curated data/combined_cda_data_median.csv is tracked.
data/raw_images_rotated/
data/cropped_images*/
data/datasets/

# Miscellaneous model artifacts (large models / notes) - keep locally only
models/00_Miscellaneous/

# containers/: track the .def build recipes and helper scripts, ignore built
# images and other artifacts
containers/*
!containers/*.def
!containers/*.slurm.sh
.vscode/
*.pytest_cache/*
*__pycache__*
*.coverage*
htmlcov/
*.egg-info/

# HPC-pulled trained models (large; re-sync from HPC with sync_from_hpc when needed).
models/*/*/results/

# Single-config test-run outputs (run_single_test.py) and in-process memory-test
# outputs (run_memory_test.py). Regenerated on the HPC; the per-config bench.json and
# memory_samples.json measurements are pulled down but not tracked.
models/*/*/testrun/
models/*/*/memtest/

# Analysis render caches (regenerated by the .qmd on first render).
analyses/*/pred_cache/
analyses/*/shap_cache/
# package_export: the 6,364-crop feature diff cache and the rendered thesis panels
# are both regenerable from the scripts beside them.
analyses/package_export/features_port.rds
analyses/package_export/thesis_plots/
# GAN diversity analysis: synced sample of generated crops + extracted features
analyses/10_gan_diversity/gan_sample/
analyses/10_gan_diversity/features.npz
analyses/10_gan_diversity/c2_features.npz

# Ordinal-forest fit cache: 95 MB, written by feature_classifiers.qmd only if
# absent and regenerated on re-render. The small derived cache beside it
# (ordinal_forest_outputs.rds) is what the document reads first, and is tracked.
analyses/*/model_cache/ordinal_forests.rds
