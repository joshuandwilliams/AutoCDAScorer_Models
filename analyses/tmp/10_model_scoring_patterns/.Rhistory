df <- read_csv("/Users/jowillia/Documents/GitHub/AutoCDAScorer_Models/analyses/10_model_scoring_patterns/results_normalised.csv", show_col_types=FALSE)
df$experiment <- str_replace_all(df$experiment, "-", "_")
print(nrow(df))
library(reshape2)
library(pheatmap)
# 1. Define Model Columns
model_cols <- c(
'567_924_Tran_CGAN_A', '574_938_CNN_Confident', '600_933_CNN_CGAN_A',
'611_974_Tran_Base', '617_961_CNN_Geom_700', '621_969_CNN_Base',
'640_950_Tran_Composite_7000', '653_968_CNN_Composite_7000', '676_970_Tran_Geom_700'
)
# 2. Calculate Residuals (Signed Error)
# Error = Model Score - Human Score
# Positive value means model over-estimated; Negative means under-estimated
residuals_df <- df %>%
select(all_of(model_cols), human_score) %>%
mutate(across(all_of(model_cols), ~ . - human_score)) %>%
select(-human_score)
# 3. Calculate Correlation Matrix of Residuals
# High correlation means models make the same magnitude of error in the same direction
res_cor_matrix <- cor(residuals_df, method = "pearson")
# 4. Generate Clustered Heatmap (Dendrogram)
# We use pheatmap because it handles the hierarchical clustering visualization automatically
pheatmap(res_cor_matrix,
clustering_distance_rows = "euclidean",
clustering_distance_cols = "euclidean",
clustering_method = "complete",
display_numbers = TRUE,
number_format = "%.2f",
color = colorRampPalette(c("white", "mistyrose", "red"))(100),
main = "Cluster Analysis of Model Error Residuals",
fontsize_number = 10)
suppressPackageStartupMessages(library(reshape2))
library(pheatmap)
# 1. Define Model Columns
model_cols <- c(
'567_924_Tran_CGAN_A', '574_938_CNN_Confident', '600_933_CNN_CGAN_A',
'611_974_Tran_Base', '617_961_CNN_Geom_700', '621_969_CNN_Base',
'640_950_Tran_Composite_7000', '653_968_CNN_Composite_7000', '676_970_Tran_Geom_700'
)
# 2. Calculate Residuals (Signed Error)
# Error = Model Score - Human Score
# Positive value means model over-estimated; Negative means under-estimated
residuals_df <- df %>%
select(all_of(model_cols), human_score) %>%
mutate(across(all_of(model_cols), ~ . - human_score)) %>%
select(-human_score)
# 3. Calculate Correlation Matrix of Residuals
# High correlation means models make the same magnitude of error in the same direction
res_cor_matrix <- cor(residuals_df, method = "pearson")
# 4. Generate Clustered Heatmap (Dendrogram)
# We use pheatmap because it handles the hierarchical clustering visualization automatically
pheatmap(res_cor_matrix,
clustering_distance_rows = "euclidean",
clustering_distance_cols = "euclidean",
clustering_method = "complete",
display_numbers = TRUE,
number_format = "%.2f",
color = colorRampPalette(c("white", "mistyrose", "red"))(100),
main = "Cluster Analysis of Model Error Residuals",
fontsize_number = 10)
# 1. Define Sort Order (Dataset -> Type)
sorted_models <- tibble(model_name = model_cols) %>%
mutate(
parts = str_split(model_name, "_"),
type = map_chr(parts, 3),
dataset = map_chr(parts, ~paste(.x[4:length(.x)], collapse = "_"))
) %>%
arrange(dataset, type) %>%
pull(model_name)
# 2. Calculate Exact Match Agreement
agreement_exact <- expand.grid(Model1 = model_cols, Model2 = model_cols, stringsAsFactors = FALSE) %>%
rowwise() %>%
mutate(Agreement = mean(df[[Model1]] == df[[Model2]], na.rm = TRUE) * 100) %>%
ungroup()
agreement_exact$Model1 <- factor(agreement_exact$Model1, levels = sorted_models)
agreement_exact$Model2 <- factor(agreement_exact$Model2, levels = sorted_models)
# 3. Calculate Near-Miss Agreement (+/- 1 score)
agreement_near_miss <- expand.grid(Model1 = model_cols, Model2 = model_cols, stringsAsFactors = FALSE) %>%
rowwise() %>%
mutate(Agreement = mean(abs(df[[Model1]] - df[[Model2]]) <= 1, na.rm = TRUE) * 100) %>%
ungroup()
agreement_near_miss$Model1 <- factor(agreement_near_miss$Model1, levels = sorted_models)
agreement_near_miss$Model2 <- factor(agreement_near_miss$Model2, levels = sorted_models)
# 4. Plot 1: Exact Agreement
ggplot(agreement_exact, aes(x = Model1, y = Model2, fill = Agreement)) +
geom_tile(color = "white") +
geom_text(aes(label = round(Agreement, 1)), color = "black", size = 3) +
scale_fill_gradient(low = "white", high = "#69b3a2") +
labs(title = "Exact Agreement (%)", x = NULL, y = NULL, fill = "%") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1), legend.position = "right") +
coord_fixed()
# 5. Plot 2: Near-Miss Agreement
ggplot(agreement_near_miss, aes(x = Model1, y = Model2, fill = Agreement)) +
geom_tile(color = "white") +
geom_text(aes(label = round(Agreement, 1)), color = "black", size = 3) +
scale_fill_gradient(low = "white", high = "#e76f51") +
labs(title = "Near-Miss Agreement (+/- 1) (%)", x = NULL, y = NULL, fill = "%") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1), legend.position = "right") +
coord_fixed()
# 1. Define Model Columns
model_cols <- c(
'567_924_Tran_CGAN_A', '574_938_CNN_Confident', '600_933_CNN_CGAN_A',
'611_974_Tran_Base', '617_961_CNN_Geom_700', '621_969_CNN_Base',
'640_950_Tran_Composite_7000', '653_968_CNN_Composite_7000', '676_970_Tran_Geom_700'
)
# 2. Calculate Residuals (Signed Error)
# Error = Model Score - Human Score
# Positive value means model over-estimated; Negative means under-estimated
residuals_df <- df %>%
select(all_of(model_cols), human_score) %>%
mutate(across(all_of(model_cols), ~ . - human_score)) %>%
select(-human_score)
# 3. Calculate Correlation Matrix of Residuals
# High correlation means models make the same magnitude of error in the same direction
res_cor_matrix <- cor(residuals_df, method = "pearson")
# 4. Generate Clustered Heatmap (Dendrogram)
# We use pheatmap because it handles the hierarchical clustering visualization automatically
pheatmap(res_cor_matrix,
clustering_distance_rows = "euclidean",
clustering_distance_cols = "euclidean",
clustering_method = "complete",
display_numbers = TRUE,
number_format = "%.2f",
color = colorRampPalette(c("white", "mistyrose", "red"))(100),
main = "Cluster Analysis of Model Error Residuals",
fontsize_number = 10)
# 2. Generate Ensemble Prediction (Rounded Median)
# We round to ensure the ensemble predicts a valid integer class (0, 1, etc.)
df$ensemble_pred <- round(apply(df[, model_cols], 1, median))
# 3. Define Helper Function for Accuracy Metrics
# Returns a list of binary vectors (1=Success, 0=Fail) for a given prediction column
get_metrics <- function(pred_col, truth_col) {
exact_match <- as.integer(pred_col == truth_col)
near_miss   <- as.integer(abs(pred_col - truth_col) <= 1)
return(list(exact = exact_match, near = near_miss))
}
# 4. Calculate Metrics for ALL Single Models
# We need to find who the "Champion" single model is based on Exact Accuracy
model_performance <- data.frame(Model = character(), Exact_Acc = numeric(), Near_Miss_Acc = numeric(), stringsAsFactors = FALSE)
for (m in model_cols) {
scores <- get_metrics(df[[m]], df$human_score)
model_performance[nrow(model_performance) + 1, ] <- list(
m,
mean(scores$exact),
mean(scores$near)
)
}
# Identify the Best Single Model (Highest Exact Accuracy)
best_model_row <- model_performance[which.max(model_performance$Exact_Acc), ]
best_model_name <- best_model_row$Model
# 5. Calculate Metrics for Ensemble
ens_scores <- get_metrics(df$ensemble_pred, df$human_score)
best_model_scores <- get_metrics(df[[best_model_name]], df$human_score)
# 6. Statistical Comparison (McNemar's Test)
# Checks if the Ensemble gets it right significantly more often than the Best Model
# We build a contingency table: [Both Right, Model Wrong/Ens Right, etc.]
# Test for Exact Accuracy
tbl_exact <- table(Best_Model = best_model_scores$exact, Ensemble = ens_scores$exact)
test_exact <- mcnemar.test(tbl_exact)
# Test for Near-Miss Accuracy
tbl_near <- table(Best_Model = best_model_scores$near, Ensemble = ens_scores$near)
test_near <- mcnemar.test(tbl_near)
# --- OUTPUT ---
cat("--- Experiment 2 Results: Ensemble vs. Best Single Model ---\n")
cat("Best Single Model: ", best_model_name, "\n\n")
cat("1. EXACT ACCURACY (Target: Human Score)\n")
cat("   Best Single Model: ", round(best_model_row$Exact_Acc * 100, 2), "%\n")
cat("   Ensemble (Median): ", round(mean(ens_scores$exact) * 100, 2), "%\n")
cat("   Stat. Significance (McNemar p-value): ", format.pval(test_exact$p.value, digits=4), "\n\n")
cat("2. NEAR-MISS ACCURACY (Target: +/- 1 Class)\n")
cat("   Best Single Model: ", round(best_model_row$Near_Miss_Acc * 100, 2), "%\n")
cat("   Ensemble (Median): ", round(mean(ens_scores$near) * 100, 2), "%\n")
cat("   Stat. Significance (McNemar p-value): ", format.pval(test_near$p.value, digits=4), "\n")
# Generate Ensemble Prediction (Rounded Median)
# We round to ensure the ensemble predicts a valid integer class (0, 1, etc.)
df$ensemble_pred <- round(apply(df[, model_cols], 1, median))
