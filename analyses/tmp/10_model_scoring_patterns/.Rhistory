cat("   Ensemble (Median): ", round(mean(ens_scores$near) * 100, 2), "%\n")
cat("   Stat. Significance (McNemar p-value): ", format.pval(test_near$p.value, digits=4), "\n")
# Generate Ensemble Prediction (Rounded Median)
# We round to ensure the ensemble predicts a valid integer class (0, 1, etc.)
df$ensemble_pred <- round(apply(df[, model_cols], 1, median))
# Define Helper Function for Accuracy Metrics
# Returns a list of binary vectors (1=Success, 0=Fail) for a given prediction column
get_metrics <- function(pred_col, truth_col) {
exact_match <- as.integer(pred_col == truth_col)
near_miss   <- as.integer(abs(pred_col - truth_col) <= 1)
return(list(exact = exact_match, near = near_miss))
}
# Calculate Metrics for ALL Single Models
# We need to find who the "Champion" single model is based on Exact Accuracy
model_performance <- data.frame(Model = character(), Exact_Acc = numeric(), Near_Miss_Acc = numeric(), stringsAsFactors = FALSE)
for (m in model_cols) {
scores <- get_metrics(df[[m]], df$human_score)
model_performance[nrow(model_performance) + 1, ] <- list(
m,
mean(scores$exact),
mean(scores$near)
)
}
# Identify the Best Single Model (Highest Exact Accuracy)
best_model_row <- model_performance[which.max(model_performance$Exact_Acc), ]
best_model_name <- best_model_row$Model
# Calculate Metrics for Ensemble
ens_scores <- get_metrics(df$ensemble_pred, df$human_score)
best_model_scores <- get_metrics(df[[best_model_name]], df$human_score)
# Statistical Comparison (McNemar's Test)
# Checks if the Ensemble gets it right significantly more often than the Best Model
# We build a contingency table: [Both Right, Model Wrong/Ens Right, etc.]
# Test for Exact Accuracy
tbl_exact <- table(Best_Model = best_model_scores$exact, Ensemble = ens_scores$exact)
test_exact <- mcnemar.test(tbl_exact)
# Test for Near-Miss Accuracy
tbl_near <- table(Best_Model = best_model_scores$near, Ensemble = ens_scores$near)
test_near <- mcnemar.test(tbl_near)
cat("Best Single Model: ", best_model_name, "\n\n")
cat("   Best Single Model: ", round(best_model_row$Exact_Acc * 100, 2), "%\n")
cat("   Ensemble (Median): ", round(mean(ens_scores$exact) * 100, 2), "%\n")
cat("   Stat. Significance (McNemar p-value): ", format.pval(test_exact$p.value, digits=4), "\n\n")
cat("   Best Single Model: ", round(best_model_row$Near_Miss_Acc * 100, 2), "%\n")
cat("   Ensemble (Median): ", round(mean(ens_scores$near) * 100, 2), "%\n")
cat("   Stat. Significance (McNemar p-value): ", format.pval(test_near$p.value, digits=4), "\n")
